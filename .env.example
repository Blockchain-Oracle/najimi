# Copy to .env and fill in. Only DATABASE_URL and the two BETTER_AUTH values are needed to start.

# Postgres (infra/compose.yaml runs one on this port)
DATABASE_URL=postgres://najimi:najimi@localhost:54330/najimi

# Better Auth: a random 32+ character secret, and the app's public origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3310

# Google sign-in (optional: guests and email codes work without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Qloo hackathon key (server-side only; never commit, never paste in a recording)
QLOO_API_KEY=

# The agent: provider:model, and that provider's key
AGENT_MODEL=openai:gpt-6-astra
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Signs tool approvals (openssl rand -base64 36); the same value on every web instance
TOOL_APPROVAL_SECRET=

# Media: images run on OPENAI_API_KEY; video needs fal.ai
FAL_KEY=

# Voice dictation (ElevenLabs Scribe) and sign-in codes (Resend)
ELEVENLABS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Object storage (compose.yaml runs RustFS on this port; production uses the internal service name)
S3_ENDPOINT=http://127.0.0.1:9300
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=najimi-dev
S3_SECRET_ACCESS_KEY=najimi-dev-secret-change-me

# Lets the deployed app's live pipe be checked from outside (16+ characters; leave empty locally)
SYSTEM_CHECK_TOKEN=

# compose.yaml's Postgres credentials
POSTGRES_USER=najimi
POSTGRES_PASSWORD=najimi
POSTGRES_DB=najimi
