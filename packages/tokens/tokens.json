{
  "_note": "Najimi tokens, encoding the Refero design lock (DICE 'gig flyer'): black ink UI, colour only inside Qloo artwork and in one confirmation green for real outcomes. Edit this file, then run `pnpm --filter @najimi/tokens build` (generate + WCAG gate). Never edit generated/. Names never change; values do.",
  "_roles": {
    "confirm": "ONLY the 'it happened' moment: live, sent, called, paid. Never a button, border, link or text colour.",
    "ash": "The frame behind artwork and the placeholder poster tile. Never a card fill for text-only content.",
    "text-4": "Stone: tertiary and disabled marks only (under 4.5:1 on purpose); never body text.",
    "destructive": "No red in the system: errors are an inverted ink banner, so destructive is ink.",
    "heat": "The map's ink: drawn at 8–72% opacity by Qloo affinity."
  },
  "defaultMode": "light",
  "themes": {
    "light": {
      "background": "#FFFFFF",
      "foreground": "#000000",
      "card": "#FFFFFF",
      "card-foreground": "#000000",
      "popover": "#FFFFFF",
      "popover-foreground": "#000000",
      "primary": "#000000",
      "primary-foreground": "#FFFFFF",
      "secondary": "#EEEEEE",
      "secondary-foreground": "#000000",
      "muted": "#EEEEEE",
      "muted-foreground": "#595959",
      "accent": "#EEEEEE",
      "accent-foreground": "#000000",
      "destructive": "#000000",
      "destructive-foreground": "#FFFFFF",
      "border": "#D9D9D9",
      "input": "#D9D9D9",
      "ring": "#000000",
      "text-2": "#333333",
      "text-3": "#595959",
      "text-4": "#808080",
      "ash": "#EEEEEE",
      "raised": "#FFFFFF",
      "confirm": "#7FFEB1",
      "confirm-foreground": "#000000",
      "heat": "#000000"
    },
    "dark": {
      "background": "#000000",
      "foreground": "#FFFFFF",
      "card": "#111111",
      "card-foreground": "#FFFFFF",
      "popover": "#111111",
      "popover-foreground": "#FFFFFF",
      "primary": "#FFFFFF",
      "primary-foreground": "#000000",
      "secondary": "#1A1A1A",
      "secondary-foreground": "#FFFFFF",
      "muted": "#1A1A1A",
      "muted-foreground": "#8C8C8C",
      "accent": "#1A1A1A",
      "accent-foreground": "#FFFFFF",
      "destructive": "#FFFFFF",
      "destructive-foreground": "#000000",
      "border": "#333333",
      "input": "#333333",
      "ring": "#FFFFFF",
      "text-2": "#BDBDBD",
      "text-3": "#8C8C8C",
      "text-4": "#666666",
      "ash": "#1A1A1A",
      "raised": "#111111",
      "confirm": "#7FFEB1",
      "confirm-foreground": "#000000",
      "heat": "#FFFFFF"
    }
  },
  "contrast": {
    "_note": "Pairs that must reach 4.5:1 in both themes (text on its ground).",
    "pairs": [
      ["foreground", "background"],
      ["card-foreground", "card"],
      ["popover-foreground", "popover"],
      ["primary-foreground", "primary"],
      ["secondary-foreground", "secondary"],
      ["muted-foreground", "background"],
      ["muted-foreground", "muted"],
      ["accent-foreground", "accent"],
      ["destructive-foreground", "destructive"],
      ["text-2", "background"],
      ["text-2", "card"],
      ["text-3", "background"],
      ["text-3", "card"],
      ["confirm-foreground", "confirm"]
    ]
  },
  "font": {
    "sans": "var(--font-inter), ui-sans-serif, system-ui, sans-serif",
    "display": "var(--font-antonio), 'Arial Narrow', ui-sans-serif, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "tracking": {
    "ui": "0.06em",
    "display": "0em"
  },
  "text": {
    "xs": ["12px", "16px"],
    "sm": ["14px", "20px"],
    "base": ["16px", "24px"],
    "lg": ["18px", "26px"],
    "xl": ["24px", "30px"],
    "2xl": ["28px", "34px"],
    "display-sm": ["80px", "0.83"],
    "display": ["96px", "0.83"],
    "display-lg": ["106px", "0.83"]
  },
  "radius": {
    "sm": "4px",
    "card": "8px",
    "nav": "20px",
    "pill": "40px",
    "tag": "9999px"
  },
  "motion": {
    "quick": "150ms",
    "state": "200ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)"
  }
}
