{
  "_note": "Najimi tokens, the OurSpaces language: paper objects on a plum-black wall. Cream paper cards with ink for everything you read, black sticker pills for chrome, kraft for tape and frames, lime as the one pop, an identity colour per person. Edit this file, then run `pnpm --filter @najimi/tokens build` (generate + WCAG gate). Never edit generated/.",
  "_roles": {
    "card": "Cream paper: every card you read (picks, plans, recipes). Ink on paper in both themes.",
    "popover": "The black sticker: popovers, menus, the composer's chips.",
    "primary": "Lime on the dark wall (the action), ink on the light wall.",
    "kraft": "Tape on media prints and frames around photos.",
    "confirm": "Only for 'it's made' / 'saved'. Never a button.",
    "violet..butter": "Identity colours: one per person profile."
  },
  "defaultMode": "dark",
  "themes": {
    "light": {
      "background": "#F4EDE4",
      "foreground": "#111114",
      "card": "#FFFAF7",
      "card-foreground": "#111114",
      "popover": "#0B0B0E",
      "popover-foreground": "#FFFFFF",
      "primary": "#111114",
      "primary-foreground": "#FFFFFF",
      "secondary": "#EADFD3",
      "secondary-foreground": "#111114",
      "muted": "#EADFD3",
      "muted-foreground": "#5F5055",
      "accent": "#EADFD3",
      "accent-foreground": "#111114",
      "destructive": "#C2185B",
      "destructive-foreground": "#FFFFFF",
      "border": "#DDCFC1",
      "input": "#DDCFC1",
      "ring": "#111114",
      "text-2": "#3A2F35",
      "text-3": "#5F5055",
      "text-4": "#8A7F87",
      "ash": "#EADFD3",
      "raised": "#FFFAF7",
      "deep": "#E6D9CB",
      "confirm": "#0F6656",
      "confirm-foreground": "#FFFFFF",
      "heat": "#111114",
      "paper": "#FFFAF7",
      "paper-foreground": "#111114",
      "paper-muted": "#5F5055",
      "kraft": "#DDC8AC",
      "kraft-foreground": "#111114",
      "sticker": "#0B0B0E",
      "sticker-foreground": "#FFFFFF",
      "lime": "#C9FF3D",
      "lime-foreground": "#111114",
      "lime-ink": "#3D6B00",
      "violet": "#7853FF",
      "pink": "#E9369D",
      "cobalt": "#3F70FF",
      "orange": "#FF7C42",
      "teal": "#13B8A6",
      "butter": "#FFB02E"
    },
    "dark": {
      "background": "#211922",
      "foreground": "#FFF6EE",
      "card": "#FFFAF7",
      "card-foreground": "#111114",
      "popover": "#0B0B0E",
      "popover-foreground": "#FFFFFF",
      "primary": "#C9FF3D",
      "primary-foreground": "#111114",
      "secondary": "#2A2230",
      "secondary-foreground": "#FFF6EE",
      "muted": "#2A2230",
      "muted-foreground": "#B4A9B1",
      "accent": "#2A2230",
      "accent-foreground": "#FFF6EE",
      "destructive": "#FF5C74",
      "destructive-foreground": "#111114",
      "border": "#3A3040",
      "input": "#3A3040",
      "ring": "#C9FF3D",
      "text-2": "#DCD2D9",
      "text-3": "#B4A9B1",
      "text-4": "#8A7F87",
      "ash": "#171119",
      "raised": "#2A2230",
      "deep": "#171119",
      "confirm": "#4DD9B1",
      "confirm-foreground": "#111114",
      "heat": "#C9FF3D",
      "paper": "#FFFAF7",
      "paper-foreground": "#111114",
      "paper-muted": "#5F5055",
      "kraft": "#DDC8AC",
      "kraft-foreground": "#111114",
      "sticker": "#0B0B0E",
      "sticker-foreground": "#FFFFFF",
      "lime": "#C9FF3D",
      "lime-foreground": "#111114",
      "lime-ink": "#3D6B00",
      "violet": "#7853FF",
      "pink": "#E9369D",
      "cobalt": "#3F70FF",
      "orange": "#FF7C42",
      "teal": "#13B8A6",
      "butter": "#FFB02E"
    }
  },
  "contrast": {
    "_note": "Pairs that must reach 4.5:1 in both themes (text on its ground).",
    "pairs": [
      ["foreground", "background"],
      ["card-foreground", "card"],
      ["popover-foreground", "popover"],
      ["primary-foreground", "primary"],
      ["secondary-foreground", "secondary"],
      ["muted-foreground", "background"],
      ["muted-foreground", "muted"],
      ["accent-foreground", "accent"],
      ["destructive-foreground", "destructive"],
      ["text-2", "background"],
      ["text-3", "background"],
      ["paper-muted", "paper"],
      ["kraft-foreground", "kraft"],
      ["lime-foreground", "lime"],
      ["lime-ink", "paper"],
      ["confirm-foreground", "confirm"],
      ["sticker-foreground", "sticker"]
    ]
  },
  "font": {
    "sans": "var(--font-plex), var(--font-plex-arabic), ui-sans-serif, system-ui, sans-serif",
    "display": "var(--font-bricolage), var(--font-plex-arabic), ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "tracking": {
    "ui": "0em",
    "display": "-0.035em"
  },
  "text": {
    "xs": ["12px", "16px"],
    "sm": ["14px", "20px"],
    "base": ["16px", "24px"],
    "lg": ["18px", "26px"],
    "xl": ["22px", "28px"],
    "2xl": ["28px", "32px"],
    "title-sm": ["clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem)", "1.02"],
    "title": ["clamp(2.5rem, 1.6rem + 3vw, 4.5rem)", "0.98"],
    "hero": ["clamp(3rem, 1.4rem + 5.6vw, 7rem)", "0.95"]
  },
  "radius": {
    "sm": "8px",
    "tile": "15px",
    "card": "20px",
    "sheet": "26px",
    "pill": "9999px",
    "tag": "9999px"
  },
  "motion": {
    "quick": "120ms",
    "state": "200ms",
    "arrive": "460ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-pop": "cubic-bezier(0.2, 0.9, 0.3, 1.18)",
    "ease-snap": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  }
}
