  "contrast": {
    "_note": "Pairs that must reach 4.5:1 in both themes (text on its ground).",
    "pairs": [
      ["foreground", "background"],
      ["card-foreground", "card"],
      ["popover-foreground", "popover"],
      ["primary-foreground", "primary"],
      ["secondary-foreground", "secondary"],
      ["muted-foreground", "background"],
      ["muted-foreground", "muted"],
      ["accent-foreground", "accent"],
      ["destructive-foreground", "destructive"],
      ["text-2", "background"],
      ["text-2", "raised"],
      ["text-3", "background"],
      ["text-3", "card"],
      ["paper-muted", "paper"],
      ["kraft-foreground", "kraft"],
      ["lime-foreground", "lime"],
      ["signal-foreground", "signal"],
      ["sticker-foreground", "sticker"],
      ["ink", "raised"],
      ["text-3", "raised"],
      ["ink", "card"]
    ]
  },
  "font": {
    "sans": "var(--font-funnel-sans), var(--font-readex), ui-sans-serif, system-ui, sans-serif",
    "display": "var(--font-funnel-display), var(--font-readex), ui-sans-serif, system-ui, sans-serif",
    "mono": "var(--font-geist-mono), ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "tracking": {
    "ui": "-0.005em",
    "display": "-0.02em"
  },
  "text": {
    "xs": ["12px", "16px"],
    "sm": ["14px", "20px"],
    "base": ["16px", "24px"],
    "lg": ["18px", "26px"],
    "xl": ["22px", "28px"],
    "2xl": ["28px", "32px"],
    "title-sm": ["clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem)", "1.05"],
    "title": ["clamp(2.25rem, 1.6rem + 3vw, 3.75rem)", "1.02"],
    "hero": ["clamp(2.75rem, 1.6rem + 5vw, 5.5rem)", "0.98"]
  },
  "radius": {
    "sm": "8px",
    "tile": "12px",
    "card": "20px",
    "sheet": "28px",
    "pill": "9999px",
    "tag": "9999px"
  },
  "motion": {
    "quick": "120ms",
    "state": "200ms",
    "arrive": "320ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-pop": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "ease-snap": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
