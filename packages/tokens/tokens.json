  "contrast": {
    "_note": "Pairs that must reach 4.5:1 in both themes (text on its ground).",
    "pairs": [
      ["foreground", "background"],
      ["card-foreground", "card"],
      ["popover-foreground", "popover"],
      ["primary-foreground", "primary"],
      ["secondary-foreground", "secondary"],
      ["muted-foreground", "background"],
      ["muted-foreground", "muted"],
      ["accent-foreground", "accent"],
      ["destructive-foreground", "destructive"],
      ["text-2", "background"],
      ["text-2", "raised"],
      ["text-3", "background"],
      ["text-3", "card"],
      ["paper-muted", "paper"],
      ["kraft-foreground", "kraft"],
      ["lime-foreground", "lime"],
      ["signal-foreground", "signal"],
      ["sticker-foreground", "sticker"],
      ["ink", "raised"]
    ]
  },
  "font": {
    "sans": "var(--font-plex), var(--font-plex-arabic), ui-sans-serif, system-ui, sans-serif",
    "display": "var(--font-serif), var(--font-plex-arabic), ui-serif, Georgia, serif",
    "mono": "var(--font-plex-mono), ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "tracking": {
    "ui": "0em",
    "display": "-0.01em"
  },
  "text": {
    "xs": ["12px", "16px"],
    "sm": ["14px", "20px"],
    "base": ["16px", "24px"],
    "lg": ["18px", "26px"],
    "xl": ["22px", "28px"],
    "2xl": ["28px", "32px"],
    "title-sm": ["clamp(2rem, 1.6rem + 1.6vw, 2.75rem)", "1.05"],
    "title": ["clamp(2.5rem, 1.8rem + 3vw, 4.25rem)", "1.02"],
    "hero": ["clamp(3rem, 1.8rem + 5vw, 6rem)", "1.0"]
  },
  "radius": {
    "sm": "6px",
    "tile": "8px",
    "card": "12px",
    "sheet": "20px",
    "pill": "9999px",
    "tag": "6px"
  },
  "motion": {
    "quick": "120ms",
    "state": "200ms",
    "arrive": "320ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-pop": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-snap": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
